{
	"info": {
		"_postman_id": "sleep-api-collection",
		"name": "Sleep API",
		"description": "API collection for the Noom Sleep Tracking application.\n\nThis API allows users to log their sleep data and retrieve sleep statistics.\n\n## Authentication\nAll endpoints require an `X-User-Id` header to identify the user.\n\n## Endpoints\n- POST /api/sleep - Log sleep data\n- GET /api/sleep/last-night - Get last night's sleep\n- GET /api/sleep/averages - Get 30-day averages",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Sleep Logs",
			"description": "Endpoints for creating and retrieving sleep logs",
			"item": [
				{
					"name": "Create Sleep Log",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-User-Id",
								"value": "{{userId}}",
								"description": "User identifier"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"bedTime\": \"2026-03-03T23:00:00\",\n    \"wakeTime\": \"2026-03-04T07:30:00\",\n    \"morningFeeling\": \"GOOD\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/sleep",
							"host": ["{{baseUrl}}"],
							"path": ["api", "sleep"]
						},
						"description": "Create or update a sleep log.\n\n**Request Body:**\n- `sleepDate` (optional): The date to log sleep for (ISO 8601 format, e.g. \"2026-03-04\"). Defaults to today if not provided.\n- `bedTime` (required): DateTime when you went to bed (ISO 8601 format)\n- `wakeTime` (required): DateTime when you woke up (ISO 8601 format)\n- `morningFeeling` (required): How you felt in the morning - `BAD`, `OK`, or `GOOD`\n\n**Notes:**\n- Wake time must be after bed time\n- If a log already exists for the specified date, it will be updated"
					},
					"response": [
						{
							"name": "Success - Created",
							"originalRequest": {
								"method": "POST",
								"header": [
									{
										"key": "X-User-Id",
										"value": "1"
									},
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n    \"bedTime\": \"2026-03-03T23:00:00\",\n    \"wakeTime\": \"2026-03-04T07:30:00\",\n    \"morningFeeling\": \"GOOD\"\n}"
								},
								"url": {
									"raw": "{{baseUrl}}/api/sleep",
									"host": ["{{baseUrl}}"],
									"path": ["api", "sleep"]
								}
							},
							"status": "Created",
							"code": 201,
							"_postman_previewlanguage": "json",
							"header": [
								{
									"key": "Content-Type",
									"value": "application/json"
								}
							],
							"body": "{\n    \"id\": 1,\n    \"userId\": 1,\n    \"sleepDate\": \"2026-03-04\",\n    \"bedTime\": \"2026-03-03T23:00:00\",\n    \"wakeTime\": \"2026-03-04T07:30:00\",\n    \"morningFeeling\": \"GOOD\",\n    \"totalTimeInBedMinutes\": 510\n}"
						}
					]
				},
