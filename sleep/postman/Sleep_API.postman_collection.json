				{
					"name": "Get 30-Day Averages",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-User-Id",
								"value": "{{userId}}",
								"description": "User identifier"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/sleep/averages",
							"host": ["{{baseUrl}}"],
							"path": ["api", "sleep", "averages"]
						},
						"description": "Get sleep averages for the last 30 days.\n\n**Response includes:**\n- `startDate` / `endDate`: The 30-day period\n- `totalNights`: Number of nights with logged sleep\n- `averageTotalTimeInBedMinutes`: Average sleep duration\n- `averageBedTime` / `averageWakeTime`: Average times\n- `morningFeelingFrequencies`: Count of each feeling type\n\n**Returns 404 if no sleep data exists for the period**"
					},
					"response": [
						{
							"name": "Success",
							"originalRequest": {
								"method": "GET",
								"header": [
									{
										"key": "X-User-Id",
										"value": "1"
									}
								],
								"url": {
									"raw": "{{baseUrl}}/api/sleep/averages",
									"host": ["{{baseUrl}}"],
									"path": ["api", "sleep", "averages"]
								}
							},
