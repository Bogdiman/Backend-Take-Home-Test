								}
							],
							"body": "{\n    \"id\": 1,\n    \"userId\": 1,\n    \"sleepDate\": \"2026-03-04\",\n    \"bedTime\": \"2026-03-03T23:00:00\",\n    \"wakeTime\": \"2026-03-04T07:30:00\",\n    \"morningFeeling\": \"GOOD\",\n    \"totalTimeInBedMinutes\": 510\n}"
